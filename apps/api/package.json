{
  "name": "@inventory/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "predb:setup": "node -e \"const f=require('fs');f.existsSync('.env')||f.copyFileSync('.env.example','.env')\"",
    "db:setup": "prisma db push --skip-generate && prisma generate && tsx prisma/seed.ts",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.0",
    "@inventory/shared": "*",
    "@prisma/client": "5.22.0",
    "fastify": "^5.2.0",
    "fastify-type-provider-zod": "^4.0.2",
    "prom-client": "^15.1.3",
    "zod": "^3.23.8",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "pino-pretty": "^13.0.0",
    "prisma": "5.22.0",
    "vitest": "^2.1.9"
  }
}
