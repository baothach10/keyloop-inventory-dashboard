generator client {
  provider = "prisma-client-js"
}

// SQLite keeps the project zero-setup. Switching to Postgres = change `provider`
// and DATABASE_URL; no application code depends on SQLite specifics.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Dealership {
  id       String    @id
  name     String
  vehicles Vehicle[]
}

model Vehicle {
  id           String          @id @default(cuid())
  dealershipId String
  dealership   Dealership      @relation(fields: [dealershipId], references: [id])
  vin          String          @unique
  make         String
  model        String
  year         Int
  trim         String?
  mileage      Int
  price        Float
  /// Date the vehicle entered inventory. Age is DERIVED from this, never stored.
  stockedAt    DateTime
  actions      VehicleAction[]

  @@index([dealershipId, stockedAt])
  @@index([dealershipId, make, model])
}

/// Append-only history of manager decisions; the newest row is the current status.
model VehicleAction {
  id         String   @id @default(cuid())
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  actionType String
  note       String?
  createdBy  String
  createdAt  DateTime @default(now())

  @@index([vehicleId, createdAt])
}
